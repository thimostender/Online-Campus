flowchart LR
  C(("Online-Campus<br/>Studierende"))
  LOGIN["Login<br/>E-Mail + Passwort · Passwort vergessen"] --> C

  C --> U["1 · Übersicht"]
  U --> U1["Heute: nächste Vorlesung<br/>mit Raum und Änderung"]
  U --> U2["Nächste Abgaben<br/>mit Countdown"]
  U --> U3["Neue Noten und<br/>Mitteilungen"]

  C --> SP["2 · Stundenplan"]
  SP --> SP1["Woche · Monat · Liste<br/>Termine und Abgaben"]
  SP --> SP2["Änderungen farbig markiert"]
  SP --> SP3["Kalender-Abo (iCal)<br/>für Outlook, Google, Apple"]
  SP --> SP4["Vorlesungsfreie Zeiten"]

  C --> M["3 · Module"]
  M --> M1["Modulliste<br/>nach nächster Frist sortiert"]
  M1 --> MS["Modulseite"]
  MS --> MS1["Überblick<br/>Lehrende · ECTS · Inhalt"]
  MS --> MS2["Termine"]
  MS --> MS3["Materialien"]
  MS --> MS4["Prüfung<br/>Art · Frist · Anforderungen"]
  MS --> MS5["Abgabe<br/>Upload · Versionen · Eingangsbestätigung"]
  MS --> MS6["Ergebnis und Feedback"]

  C --> LE["4 · Leistungen"]
  LE --> LE1["Alle Abgaben<br/>offen · eingereicht · bewertet"]
  LE --> LE2["Noten und ECTS-Stand"]
  LE --> LE3["Bescheinigungen<br/>herunterladen"]
  LE --> LE4["Studienverlauf<br/>6 Semester · Wahlfach wählen"]

  C --> SV["5 · Service"]
  SV --> SV1["Lageplan und Räume"]
  SV --> SV2["Ansprechpersonen"]
  SV --> SV3["Wissenschaftliches Arbeiten"]
  SV3 --> SV3a["Vorlagen zum Herunterladen"]
  SV --> SV4["Formulare und FAQ"]

  C -.-> K["Kopfzeile, immer sichtbar"]
  K -.-> MI["Glocke: Mitteilungen"]
  MI -.-> MI1["Neuigkeiten"]
  MI -.-> MI2["Änderungen"]
  MI -.-> MI3["Nachrichten (optional)"]
  K -.-> PR["Profil"]
  PR -.-> PR1["Persönliche Daten"]
  PR -.-> PR2["Benachrichtigungen<br/>je Anlass und Kanal"]
  PR -.-> PR3["Abmelden"]
  K -.-> HI["Suche"]
  C -.-> AS["Hilfe-Assistent<br/>auf jeder Seite"]
  AS -.-> AS1["Persönlich: Fristen, Termine,<br/>Noten, ECTS"]
  AS -.-> AS2["Fachlich: aus Lehrmaterialien<br/>mit Quelle und Seite"]

